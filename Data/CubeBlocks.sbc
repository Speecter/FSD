        <MountPoint Side="Back" StartX="0.6" StartY="0.3" EndX="2.4" EndY="1.1" />
        <MountPoint Side="Left" StartX="0.3" StartY="0" EndX="2.7" EndY="2" />
        <MountPoint Side="Left" StartX="0" StartY="0.3" EndX="3" EndY="1.7" />
        <MountPoint Side="Right" StartX="0.3" StartY="0" EndX="2.7" EndY="0.2" />
        <MountPoint Side="Right" StartX="0.3" StartY="1.8" EndX="2.7" EndY="2" />
        <MountPoint Side="Right" StartX="0" StartY="0.3" EndX="0.2" EndY="1.7" />
        <MountPoint Side="Right" StartX="2.8" StartY="0.3" EndX="3" EndY="1.7" />
        <MountPoint Side="Right" StartX="1.1" StartY="0.6" EndX="1.9" EndY="1.4" />
      </MountPoints>
      <BuildProgressModels>
        <Model BuildPercentUpperBound="0.33" File="Models\Cubes\Large\JumpDriveReskinConstruction_1.mwm" />
        <Model BuildPercentUpperBound="0.66" File="Models\Cubes\Large\JumpDriveReskinConstruction_2.mwm" />
        <Model BuildPercentUpperBound="1.00" File="Models\Cubes\Large\JumpDriveReskinConstruction_3.mwm" />
      </BuildProgressModels>
      <BlockPairName>FSDriveReskin_B</BlockPairName>
